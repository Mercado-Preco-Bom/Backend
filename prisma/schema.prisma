generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis]
}

enum Role {
  ADMIN
  CASHIER
  DRIVER
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  
  lastLatitude  Float?
  lastLongitude Float?
  lastLocationAt DateTime?

  deliveries Delivery[] @relation("DriverDeliveries")
  
  baseReturns DriverBaseReturn[]
}

model DriverBaseReturn {
  id        String   @id @default(uuid())
  driverId  String
  driver    User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  arrivedAt DateTime @default(now())
}

model Customer {
  id           String   @id @default(uuid())
  name         String
  phone        String?
  street       String
  number       String
  neighborhood String
  reference    String?
  createdAt    DateTime @default(now())

  coordinates Unsupported("geometry(Point, 4326)")?

  deliveries Delivery[]
}

model Delivery {
  id            String  @id @default(uuid())
  boxCount      Int
  paymentMethod String
  changeFor     Float?
  isPaid        Boolean @default(false)
  amount        Float?
  status        String  @default("PENDING")

  description   String?

  createdAt DateTime @default(now())

  assignedAt        DateTime?
  assignedLatitude  Float?
  assignedLongitude Float?

  startedAt      DateTime?
  startLatitude  Float?
  startLongitude Float?

  finishedAt   DateTime?
  endLatitude  Float?
  endLongitude Float?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  driverId String?
  driver   User?    @relation("DriverDeliveries", fields: [driverId], references: [id])

  trackPoints DeliveryTrackPoint[]
}

model DeliveryTrackPoint {
  id         String   @id @default(uuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  latitude  Float
  longitude Float
  speed     Float?
  heading   Float?
  accuracy  Float?

  recordedAt DateTime

  @@index([deliveryId, recordedAt])
}